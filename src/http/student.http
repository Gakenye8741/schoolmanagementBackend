@baseUrl = http://localhost:5000/api
@studentsUrl = {{baseUrl}}/students
@schoolId = 52426aab-497c-4880-8f8a-ad8a385f6e2b
@classId = 1deeec22-8ddc-4f51-9458-5803a4e6d031
@class2Id = 00000000-0000-0000-0000-000000000005
@parentUserId = 89813af8-bc98-45dd-aaeb-cd7de0eaab85

### ================================================================
### 1. REGISTRATION
### ================================================================

### 1.1 Register a student (unplaced)
# @name regStudent
POST {{studentsUrl}}
Content-Type: application/json

{
  "schoolId": "{{schoolId}}",
  "email": "brian1.student@school.test",
  "password": "StudentPass123",
  "admissionNumber": "ADM-2027-002",
  "firstName": "brian",
  "lastName": "Student",
  "gender": "Male",
  "dateOfBirth": "2014-05-12"
}

### 1.2 Register a student WITH a class at admission
# @name regStudentWithClass
POST {{studentsUrl}}
Content-Type: application/json

{
  "schoolId": "{{schoolId}}",
  "email": "mary.student@school.test",
  "password": "StudentPass123",
  "admissionNumber": "ADM-2026-002",
  "firstName": "Mary",
  "lastName": "Student",
  "gender": "Female",
  "dateOfBirth": "2013-07-22",
  "classId": "{{classId}}"
}

### Captured:
@studentId = 238eb983-1d32-46b3-98e8-737741356055
@studentUserId = {{regStudent.response.body.$.user.id}}

### ================================================================
### 2. READS
### ================================================================

### 2.1 Get by ID
GET {{studentsUrl}}/{{studentId}}

### 2.2 Get with relations
GET {{studentsUrl}}/{{studentId}}/with-relations

### 2.3 Get by user ID
GET {{studentsUrl}}/user/{{studentUserId}}

### 2.4 Get by admission number
GET {{studentsUrl}}/school/{{schoolId}}/admission?admissionNumber=ADM-2027-001

### 2.5 List by school
GET {{studentsUrl}}/school/{{schoolId}}

### 2.6 List by class
GET {{studentsUrl}}/class/{{classId}}

### 2.7 Search
GET {{studentsUrl}}/school/{{schoolId}}/search?query=Sam

### ================================================================
### 3. UPDATE / DELETE
### ================================================================

### 3.1 Update
PUT {{studentsUrl}}/{{studentId}}
Content-Type: application/json

{
  "middleName": "Mwangi",
  "upiNumber": "UPI-2026-0001"
}

### 3.2 Soft delete (super admin)
DELETE {{studentsUrl}}/{{studentId}}

### 3.3 Restore
POST {{studentsUrl}}/{{studentId}}/restore

### ================================================================
### 4. LIFECYCLE
### ================================================================

### 4.1 Enroll unplaced student in a class
POST {{studentsUrl}}/{{studentId}}/class
Content-Type: application/json

{
  "classId": "{{classId}}",
  "requireUnplaced": true
}

### 4.2 Withdraw
POST {{studentsUrl}}/{{studentId}}/withdraw
Content-Type: application/json

{
  "reason": "Family relocated to Mombasa"
}

### 4.3 Re-enroll
POST {{studentsUrl}}/{{studentId}}/re-enroll

### 4.4 Promote
POST {{studentsUrl}}/{{studentId}}/promote
Content-Type: application/json

{}

### 4.5 Graduate (final-grade only)
POST {{studentsUrl}}/{{studentId}}/graduate
Content-Type: application/json

{}

### 4.6 Repeat grade
POST {{studentsUrl}}/{{studentId}}/repeat
Content-Type: application/json

{}

### 4.7 Transfer out
POST {{studentsUrl}}/{{studentId}}/transfer-out
Content-Type: application/json

{
  "toSchool": "Nairobi Academy",
  "reason": "Parent posted to Nairobi"
}

### 4.8 Bulk promote a class
POST {{studentsUrl}}/bulk-promote
Content-Type: application/json

{
  "schoolId": "{{schoolId}}",
  "fromClassId": "{{classId}}",
  "toClassId": "{{class2Id}}"
}

### ================================================================
### 5. GUARDIANS
### ================================================================

### 5.1 Add guardian
POST {{studentsUrl}}/{{studentId}}/guardians
Content-Type: application/json

{
  "guardianUserId": "{{parentUserId}}",
  "relationship": "Father",
  "isPrimary": true,
  "isFeePayer": true
}

### 5.2 List guardians
GET {{studentsUrl}}/{{studentId}}/guardians

### 5.3 Set primary
PUT {{studentsUrl}}/{{studentId}}/guardians/primary
Content-Type: application/json

{
  "guardianUserId": "{{parentUserId}}"
}

### 5.4 Update relationship
PUT {{studentsUrl}}/{{studentId}}/guardians/{{parentUserId}}
Content-Type: application/json

{
  "relationship": "Guardian",
  "canPickup": false
}

### 5.5 List students for a guardian
GET {{studentsUrl}}/guardian/{{parentUserId}}

### 5.6 Remove guardian
DELETE {{studentsUrl}}/{{studentId}}/guardians
Content-Type: application/json

{
  "guardianUserId": "{{parentUserId}}"
}

### ================================================================
### 6. ENROLLMENT HISTORY
### ================================================================

### 6.1 Full history
GET {{studentsUrl}}/{{studentId}}/enrollments

### 6.2 Current enrollment
GET {{studentsUrl}}/{{studentId}}/enrollments/current

### ================================================================
### 7. DOCUMENTS
### ================================================================

### 7.1 Add document
POST {{studentsUrl}}/{{studentId}}/documents
Content-Type: application/json

{
  "schoolId": "{{schoolId}}",
  "category": "BirthCertificate",
  "title": "Birth Certificate",
  "fileUrl": "https://example.com/files/birth-cert.pdf",
  "isVisibleToParent": true
}

### 7.2 List documents
GET {{studentsUrl}}/{{studentId}}/documents

### ================================================================
### 8. HEALTH RECORDS
### ================================================================

### 8.1 Add health record
POST {{studentsUrl}}/{{studentId}}/health
Content-Type: application/json

{
  "schoolId": "{{schoolId}}",
  "recordType": "Allergy",
  "title": "Peanut allergy",
  "description": "Severe reaction — EpiPen kept at sick bay."
}

### 8.2 List health records
GET {{studentsUrl}}/{{studentId}}/health

### ================================================================
### 9. STATS
### ================================================================

### 9.1 Count by school
GET {{studentsUrl}}/school/{{schoolId}}/count

### 9.2 Count by class
GET {{studentsUrl}}/class/{{classId}}/count

### 9.3 Gender breakdown
GET {{studentsUrl}}/school/{{schoolId}}/by-gender

### 9.4 Student statistics
GET {{studentsUrl}}/{{studentId}}/statistics

### 9.5 Validate data
GET {{studentsUrl}}/{{studentId}}/validate