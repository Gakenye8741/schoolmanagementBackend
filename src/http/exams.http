### Variable placeholders for testing references
@termId = 43530ca6-bd8f-4cf1-b45e-288ce29750d0
@examId = 0abc3db2-956e-4918-b9df-1fbfa9467962
@assessmentId = d7afdd1f-c63b-4e01-a42e-92aa06b1ed29
@studentId = d3aadd77-7f9f-2bc6-994b-4ff7fb160d44
