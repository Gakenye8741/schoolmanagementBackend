@teacherId = a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11

### 1. Create a Term Exam Record
POST {{examsUrl}}/term-exams
Authorization: Bearer {{schoolAdminToken}}
Content-Type: application/json

{
  "termId": "{{termId}}",
  "examTitle": "Term 1 Mid-Term Assessment",
  "examCategory": "Mid-Term",
  "startDate": "2026-03-10",
  "endDate": "2026-03-14",
  "isLocked": false
}

### 2. Get Term Exams by Term ID
GET {{examsUrl}}/term-exams/term/{{termId}}
Authorization: Bearer {{schoolAdminToken}}

### 3. Get Term Exam by ID
GET {{examsUrl}}/term-exams/{{examId}}
Authorization: Bearer {{schoolAdminToken}}

### 4. Update Term Exam Details
PUT {{examsUrl}}/term-exams/{{examId}}
Authorization: Bearer {{schoolAdminToken}}
Content-Type: application/json

{
  "examTitle": "Term 1 Mid-Term Assessment (Updated)",
  "isLocked": false
}

### 5. Create a Single CBC Assessment Score
POST {{examsUrl}}/assessments
Authorization: Bearer {{schoolAdminToken}}
Content-Type: application/json

{
  "studentId": "{{studentId}}",
  "subjectId": "{{subjectId}}",
  "termId": "{{termId}}",
  "examId": "{{examId}}",
  "strand": "Numbers",
  "subStrand": "Whole Numbers",
  "scoreValue": 18.00,
  "outOf": 20.00,
  "performanceLevel": "EE",
  "teacherRemarks": "Shows exceptional analytical and mathematical skills.",
  "assessedBy": "{{teacherId}}"
}

### 6. Bulk Create/Update CBC Assessments (Class Marksheet)
POST {{examsUrl}}/assessments/bulk
Authorization: Bearer {{schoolAdminToken}}
Content-Type: application/json

[
  {
    "studentId": "{{studentId}}",
    "subjectId": "{{subjectId}}",
    "termId": "{{termId}}",
    "examId": "{{examId}}",
    "strand": "Numbers",
    "subStrand": "Whole Numbers",
    "scoreValue": 18.00,
    "outOf": 20.00,
    "performanceLevel": "EE",
    "teacherRemarks": "Exceptional work.",
    "assessedBy": "{{teacherId}}"
  }
]

### 7. Get CBC Assessment by ID
GET {{examsUrl}}/assessments/{{assessmentId}}
Authorization: Bearer {{schoolAdminToken}}

### 8. Get Student CBC Assessments
GET {{examsUrl}}/assessments/student/{{studentId}}?termId={{termId}}&examId={{examId}}
Authorization: Bearer {{schoolAdminToken}}

### 9. Get Exam Subject Performance Analytics
GET {{examsUrl}}/assessments/analytics/exam/{{examId}}/subject/{{subjectId}}
Authorization: Bearer {{schoolAdminToken}}

### 10. Get Student Term Report Card Summary
GET {{examsUrl}}/assessments/report-card/student/{{studentId}}/term/{{termId}}/exam/{{examId}}
Authorization: Bearer {{schoolAdminToken}}

### 11. Get Exam Summary Analytics (School/Grade Breakdown)
GET {{examsUrl}}/assessments/analytics/exam/{{examId}}/summary
Authorization: Bearer {{schoolAdminToken}}

### 12. Delete CBC Assessment Record
DELETE {{examsUrl}}/assessments/{{assessmentId}}
Authorization: Bearer {{schoolAdminToken}}

### 13. Delete Term Exam Record
DELETE {{examsUrl}}/term-exams/{{examId}}
Authorization: Bearer {{schoolAdminToken}}