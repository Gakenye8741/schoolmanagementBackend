### 2. List all schools (Admin)
GET {{baseUrl}}/schools
Cookie: token={{superAdminToken}}

### 3. Get school by ID (Any authenticated user)
GET {{baseUrl}}/schools/{{schoolId}}
Cookie: token={{studentoken}}

### 4. Get school by slug (Public / Portal Resolution)
GET {{baseUrl}}/schools/slug/{{slug}}

### 5. Update school details (Super Admin)
PUT {{baseUrl}}/schools/{{schoolId}}
Content-Type: application/json
Cookie: token={{superAdminToken}}

{
  "name": "Nyayo Primary School",
  "motto": "Excellence and Integrity",
  "logoUrl": "https://images.unsplash.com/photo-1546410531-bb4caa6b424d?w=400&auto=format&fit=crop&q=80",
  "faviconUrl": "https://images.unsplash.com/photo-1546410531-bb4caa6b424d?w=100&auto=format&fit=crop&q=80",
  "coverImageUrl": "https://images.unsplash.com/photo-1523050854058-8df90110c9f1?w=1200&auto=format&fit=crop&q=80"
}

### 6. Toggle school status (Super Admin)
PATCH {{baseUrl}}/schools/{{schoolId}}/status
Content-Type: application/json
Cookie: token={{superAdminToken}}

{
  "isActive": false
}

### 7. Update school branding (Admin)
PATCH {{baseUrl}}/schools/{{schoolId}}/branding
Content-Type: application/json
Cookie: token={{schoolAdminToken}}

{
  "logoUrl": "https://cdn.example.com/schools/nyayo/logo.png",
  "primaryColor": "#020202",
  "secondaryColor": "#ce0bf5"
}

### 8. Update school subscription (Super Admin)
PATCH {{baseUrl}}/schools/{{schoolId}}/subscription
Content-Type: application/json
Cookie: token={{superAdminToken}}

{
  "subscriptionPlan": "Trial",
  "subscriptionStatus": "Active",
  "subscriptionExpiresAt": "2027-09-03T16:54:32.000Z"
}

### 9. Update school settings (Admin)
PATCH {{baseUrl}}/schools/{{schoolId}}/settings
Content-Type: application/json
Cookie: token={{schoolAdminToken}}

{
  "principalName": "Dr. John Kamau",
  "establishedYear": 1995
}

### 10. Update school contact & location (Admin)
PATCH {{baseUrl}}/schools/{{schoolId}}/contact
Content-Type: application/json
Cookie: token={{schoolAdminToken}}

{
  "address": "P.O. Box 450-20300",
  "county": "Nyandarua",
  "subCounty": "Nyahururu",
  "phone": "+254722345678",
  "email": "admin@nyahururuhigh.ac.ke",
  "website": "https://nyahururuhigh.ac.ke"
}