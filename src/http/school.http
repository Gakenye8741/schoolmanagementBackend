### 1. Create a school (Super Admin) - Local Example
POST {{baseUrl}}/schools
Content-Type: application/json
Cookie: token={{superAdminToken}}

{
  "name": "Nyahururu High School",
  "shortName": "Nyahururu High",
  "slug": "nyahururu-high",
  "motto": "Strive for Excellence",
  "registrationNumber": "MOE/SEC/2005/0892",
  "knecCode": "23456789",
  "schoolType": "Secondary",
  "curriculumType": "CBC",
  "establishedYear": 1985,
  "primaryColor": "#1E3A8A",
  "secondaryColor": "#D97706",
  "timezone": "Africa/Nairobi",
  "currency": "KES",
  "principalName": "Dr. Peter Kiprop",
  "subscriptionPlan": "Standard",
  "subscriptionStatus": "Active"
}

